    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamento" type="Real" array="False" size=""/>
            <declare name="empresa" type="String" array="False" size=""/>
            <output expression="&quot;Qual o nome da empresa do lead?&quot;" newline="True"/>
            <input variable="empresa"/>
            <output expression="&quot;Qual o seu or&#231;amento?&quot;" newline="True"/>
            <input variable="orcamento"/>
            <if expression="orcamento &gt; 0 AND empresa != &quot;&quot;">
                <then>
                    <output expression="&quot;Lead v&#225;lido&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Faltam dados&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
