    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lead" type="Integer" array="False" size=""/>
            <output expression="&quot;Qual a pontua&#231;&#227;o de interesse do lead?&quot;" newline="True"/>
            <input variable="lead"/>
            <if expression="lead = 70 OR lead &gt; 70">
                <then>
                    <output expression="&quot;O lead &#233; de Interesse Alto.&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="lead = 40 OR lead &gt; 40">
                        <then>
                            <output expression="&quot;O lead &#233; de Interesse M&#233;dio.&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;O lead &#233; de Interesse Baixo.&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
