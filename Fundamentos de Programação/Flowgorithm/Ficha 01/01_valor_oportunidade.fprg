<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="0.1_valor_oportunidade"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 10:03:06 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjA5OjE2OjE3ICI7Mjc3NA=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjEwOjAzOjA2ICI7MTsyODY4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="preco, desconto, oportunidade" type="Real" array="False" size=""/>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Qual o pre&#231;o unit&#225;rio&quot;" newline="True"/>
            <input variable="preco"/>
            <output expression="&quot;Qual o n&#250;mero de unidades do produto?&quot;" newline="True"/>
            <input variable="numero"/>
            <output expression="&quot;Qual o desconto?&quot;" newline="True"/>
            <input variable="desconto"/>
            <assign variable="oportunidade" expression="preco * numero * (1-desconto)"/>
            <output expression="&quot;O valor da oportunidade &#233; de &quot; &amp; oportunidade &amp; &quot; euros.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
