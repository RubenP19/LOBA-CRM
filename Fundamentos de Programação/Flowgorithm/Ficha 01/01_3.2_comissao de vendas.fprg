<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="01_3.2_comissao de vendas"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 10:38:18 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjEwOjMyOjQ4ICI7Mjc2OA=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjEwOjM4OjE4ICI7MTsyODc5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="venda, comissao" type="Real" array="False" size=""/>
            <output expression="&quot;Qaul o valor da venda?&quot;" newline="True"/>
            <input variable="venda"/>
            <if expression="venda &gt;= 5000">
                <then>
                    <assign variable="comissao" expression="venda * 0.15"/>
                </then>
                <else>
                    <assign variable="comissao" expression="venda * 0.1"/>
                </else>
            </if>
            <output expression="&quot;O valor da comiss&#227;o &#233; &quot; &amp; comissao &amp; &quot; euros.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
