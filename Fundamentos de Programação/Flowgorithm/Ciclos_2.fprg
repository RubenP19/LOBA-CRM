<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ciclos_2"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 11:20:49 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTg7IjEwOjAyOjA4ICI7Mjc2OQ=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTg7IjExOjIwOjQ5ICI7MTsyODgz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="orc" type="Real" array="True" size="5"/>
            <declare name="maior" type="Real" array="False" size=""/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Or&#231;amento &quot; &amp; i + 1 &amp; &quot;:&quot;" newline="True"/>
                <input variable="orc[i]"/>
                <while expression="orc[i] &lt; 0">
                    <output expression="&quot;Erro. Or&#231;amento &quot; &amp; i + 1 &amp; &quot;:&quot;" newline="True"/>
                    <input variable="orc[i]"/>
                </while>
            </for>
            <assign variable="maior" expression="orc[0]"/>
            <for variable="i" start="1" end="4" direction="inc" step="1">
                <if expression="orc[i] &gt; maior">
                    <then>
                        <assign variable="maior" expression="orc[i]"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Maior: &quot; &amp; maior" newline="True"/>
        </body>
    </function>
</flowgorithm>
