    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="venda, comissao, valor" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor de venda do comercial?&quot;" newline="True"/>
            <input variable="venda"/>
            <assign variable="comissao" expression="0.05"/>
            <assign variable="valor" expression="venda * comissao"/>
            <output expression="&quot;O valor da comiss&#227;o do comercial &#233; &quot; &amp; valor &amp; &quot; &#8364;.&quot;" newline="True"/>
        </body>
    </function>
