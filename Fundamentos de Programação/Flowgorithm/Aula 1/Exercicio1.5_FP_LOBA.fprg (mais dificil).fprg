<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio1.5_FP_LOBA.fprg (mais dificil)"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-04 03:00:06 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjAyOjUwOjI1ICI7Mjc2Nw=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjAzOjAwOjA2ICI7MTsyODcw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orc" type="Real" array="False" size=""/>
            <declare name="prioridade, interesse" type="String" array="False" size=""/>
            <output expression="&quot;Or&#231;amento: &quot;" newline="True"/>
            <input variable="orc"/>
            <output expression="&quot;Interesse: &quot;" newline="True"/>
            <input variable="interesse"/>
            <if expression="orc &gt; 10000 AND interesse = &quot;alto&quot;">
                <then>
                    <output expression="&quot;Prioridade &#233; quente&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="orc &gt; 5000 AND interesse = &quot;m&#233;dio&quot;">
                        <then>
                            <output expression="&quot;Prioridade &#233; m&#233;dia&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Prioridade &#233; fria&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
