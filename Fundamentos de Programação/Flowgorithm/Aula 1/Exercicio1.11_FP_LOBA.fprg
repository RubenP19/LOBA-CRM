<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio1.11_FP_LOBA"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-04 05:45:20 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjA1OjMyOjM3ICI7Mjc3Mw=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjA1OjQ1OjIwICI7MjsyODc4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Este fluxograma pede ao utilizador para adivinhar um numero fixo. O programa compara cada tentativa com o valor correto e continua a pedir novos valores at&#233; que o utilizador acerte. "/>
            <declare name="numeroSecreto, tentativa, i" type="Integer" array="False" size=""/>
            <assign variable="numeroSecreto" expression="7"/>
            <output expression="&quot;Tenta adivinhar o n&#250;mero secreto: &quot;" newline="True"/>
            <input variable="tentativa"/>
            <assign variable="i" expression="1"/>
            <while expression="tentativa != numeroSecreto">
                <assign variable="i" expression="i + 1"/>
                <comment text="Ciclo enquanto se repete as tentativas e n&#227;o se acerta"/>
                <if expression="tentativa &lt; numeroSecreto">
                    <then>
                        <output expression="&quot;O n&#250;mero secreto &#233; maior que &quot; &amp; tentativa" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;O n&#250;mero secreto &#233; menor que &quot; &amp; tentativa" newline="True"/>
                    </else>
                </if>
                <output expression="&quot;Tenta novamente: &quot;" newline="True"/>
                <input variable="tentativa"/>
            </while>
            <output expression="&quot;Parab&#233;ns, acertaste! Conseguiste acertar em&quot; &amp; i &amp; &quot;tentativas&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
