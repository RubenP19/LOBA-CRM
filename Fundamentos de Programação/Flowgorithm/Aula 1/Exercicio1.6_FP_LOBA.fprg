        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjAzOjI1OjUwICI7MTsyODc2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira um n&#250;mero para verificar se &#233; par ou impar: &quot;" newline="True"/>
            <input variable="numero"/>
            <declare name="resto" type="Integer" array="False" size=""/>
            <assign variable="resto" expression="numero % 2"/>
            <if expression="resto == 0">
                <then>
                    <output expression="&quot;O n&#250;mero &quot; &amp; numero &amp; &quot; &#233; par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero &quot; &amp; numero &amp; &quot; &#233; impar&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
