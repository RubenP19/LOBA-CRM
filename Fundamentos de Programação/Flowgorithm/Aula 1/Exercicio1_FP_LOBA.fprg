        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMDQ7IjEyOjM2OjUzICI7MTsyODgx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="preco, desconto, valor" type="Real" array="False" size=""/>
            <declare name="unidades" type="Integer" array="False" size=""/>
            <output expression="&quot;Pre&#231;o Unit&#225;rio: &quot;" newline="True"/>
            <input variable="preco"/>
            <output expression="&quot;N&#186; de unidades: &quot;" newline="True"/>
            <input variable="unidades"/>
            <output expression="&quot;Desconto (ex. 0.10 para 10%): &quot;" newline="True"/>
            <input variable="desconto"/>
            <assign variable="valor" expression="preco * unidades * (1 - desconto)"/>
            <output expression="&quot;Valor da oportunidade &#233; &quot; &amp; valor" newline="True"/>
        </body>
    </function>
</flowgorithm>
