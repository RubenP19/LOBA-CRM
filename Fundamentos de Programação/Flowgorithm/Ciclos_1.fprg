<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ciclos_1"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 10:02:05 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTg7IjA5OjI5OjAxICI7Mjc3OQ=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTg7IjEwOjAyOjA1ICI7MTsyODc0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="total, media, orc" type="Real" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <output expression="&quot;Or&#231;amento &quot; &amp; i &amp; &quot;:&quot;" newline="True"/>
                <input variable="orc"/>
                <assign variable="total" expression="total + orc"/>
            </for>
            <assign variable="media" expression="total/5"/>
            <output expression="&quot;Total: &quot; &amp; total" newline="True"/>
            <output expression="&quot;M&#233;dia: &quot; &amp; media" newline="True"/>
        </body>
    </function>
</flowgorithm>
