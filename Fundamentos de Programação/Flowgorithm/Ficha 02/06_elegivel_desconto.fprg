        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjAzOjA2OjIwICI7MjsyODcw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cliente" type="Boolean" array="False" size=""/>
            <declare name="valor" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor da compra?&quot;" newline="True"/>
            <input variable="valor"/>
            <output expression="&quot;O cliente &#233; antigo.(true/false)&quot;" newline="True"/>
            <input variable="cliente"/>
            <if expression="valor &gt; 100 AND cliente = true">
                <then>
                    <output expression="&quot;O cliente tem desconto.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O cliente n&#227;o tem desconto&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
