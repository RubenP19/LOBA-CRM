    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nseg, seg, min" type="Integer" array="False" size=""/>
            <output expression="&quot;Escreve o n&#250;mero de segundos&quot;" newline="True"/>
            <input variable="nseg"/>
            <assign variable="min" expression="nseg/60"/>
            <assign variable="seg" expression="nseg % 60"/>
            <output expression="&quot;Isto equivale a &quot; &amp; min &amp; &quot; minutos e &quot; &amp; seg &amp; &quot; segundos.&quot;" newline="True"/>
        </body>
    </function>
