    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="ava1, ava2, media" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor da primeira avalia&#231;&#227;o?&quot;" newline="True"/>
            <input variable="ava1"/>
            <output expression="&quot;Qual o valor da segunda avalia&#231;&#227;o?&quot;" newline="True"/>
            <input variable="ava2"/>
            <assign variable="media" expression="(ava1*0.4)+(ava2*0.6)"/>
            <output expression="&quot;A m&#233;dia ponderada das avalia&#231;&#245;es &#233; de &quot; &amp; media&amp; &quot;.&quot;" newline="True"/>
        </body>
    </function>
