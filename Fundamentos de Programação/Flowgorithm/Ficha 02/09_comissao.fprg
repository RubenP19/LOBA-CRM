<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="0.8_comissao"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 03:11:40 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjAzOjA3OjMwICI7Mjc2Mw=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KUzVNSEM2OzIwMjYtMDgtMTA7IjAzOjExOjQwICI7MTsyODY3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="venda, comissao, valor" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor da venda?&quot;" newline="True"/>
            <input variable="venda"/>
            <if expression="venda &gt; 200">
                <then>
                    <assign variable="comissao" expression="0.15"/>
                </then>
                <else>
                    <if expression="venda &gt; 100">
                        <then>
                            <assign variable="comissao" expression="0.10"/>
                        </then>
                        <else>
                            <assign variable="comissao" expression="0.05"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="valor" expression="venda * comissao"/>
            <output expression="&quot;O valor da comiss&#227;o &#233; &quot; &amp; valor &amp; &quot; euros.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
