    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor, iva, total" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o pre&#231;o sem IVA?&quot;" newline="True"/>
            <input variable="valor"/>
            <output expression="&quot;Qual o IVA desta compra? (0-1)&quot;" newline="True"/>
            <input variable="iva"/>
            <assign variable="total" expression="valor + (valor * IVA)"/>
            <output expression="&quot;O valor total &#233; &quot; &amp; total &amp; &quot; euros. O IVA deste produto &#233; de &quot; &amp; iva *100 &amp; &quot;%.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
